+ #ifdef DO_PTRACE
+ /*===========================================================================*
+  *				do_trace				     * 
+  *===========================================================================*/
+ 
+ #define PROCNR	(m->m2_i1)
+ #define REQUEST (m->m2_i2)
+ #define ADDR	((vir_bytes)m->m2_l1)
+ #define DATA	(m->m2_l2)
+ #define VLSIZE	((vir_bytes)sizeof(long))
+ 
+ PRIVATE int do_trace(m)
+ register message *m;
+ {
+   register struct proc *rp;
+   phys_bytes umap(), src, dst;
+   int i;
+ 
+   rp = proc_addr(PROCNR);
+   if (rp->p_flags & P_SLOT_FREE) return EIO;
+   switch (REQUEST) {
+ 	case -1: /* stop process */
+ 		unready(rp);
+ 		rp->p_flags |= P_STOP;
+ #if (MACHINE == PC532)
+ 		rp->p_mod_psr &= ~TRACEBIT; /* clear trace bit */
+ #else
+ 		rp->p_pcpsw.psw &= ~TRACEBIT; /* clear trace bit */
+ #endif
+ 		return OK;
+ 	case 1: /* return value from instruction space */
+ 	case 2: /* return value from data space */
+ #if (MACHINE == PC532)
+ 		/* should we do more error checking ? */
+ 		if (v_copy (rp, ADDR, 0L, &DATA, VLSIZE) != VLSIZE)
+ 		  return EIO;
+ #else
+ 		return EIO;
+ #endif
+ 		break;
+ 	case 3: /* return value from process table */
+ 		if ((ADDR & (sizeof(long) - 1)) != 0 ||
+ 		    ADDR > sizeof(struct proc) - sizeof(long))
+ 		  return(EIO);
+ 		DATA = *(long *)((char *)rp + (int)ADDR);
+ 		break;
+ 	case 4: /* set value from instruction space */
+ 		/* Hmm, I wonder how modifying text on the pc532
+ 		   minix works - might not */
+ 	case 5: /* set value from data space */
+ #if (MACHINE == PC532)
+ 		/* should we do more error checking ? */
+ 		if (v_copy (0L, &DATA, rp, ADDR, VLSIZE) != VLSIZE)
+ 		  return EIO;
+ 		else
+ 		  DATA = 0;
+ 		return OK;
+ #else
+ 		return EIO;
+ #endif
+ 		break;
+ 	case 6: /* set value in process table */
+ #if (MACHINE == PC532)
+ 		if ((ADDR & (sizeof (long) - 1)) != 0 ||
+ 		    ADDR > ((char *)&rp->p_flags - (char *)&rp->p_reg[0]))
+ 		  return(EIO);
+ 		if (ADDR == ((char *)&rp->p_mod_psr - (char *)&rp->p_reg[0])) {
+ 		  /* only selected bits are changeable */
+ 		  SETBITS(rp, DATA);
+ 		}
+ 		else {
+ 		  *(long *)((char *)&rp->p_reg[0] + ADDR) = DATA;
+ 		}
+ 		DATA = 0;
+ 		break;
+ #else
+ #if (CHIP == INTEL)
+ 	/* Altering segment registers might crash the kernel when it
+ 	 * tries to load them prior to restarting a process, so do
+ 	 * not allow it.
+ 	 */
+ 	if (i == (int) &((struct proc *) 0)->p_reg.cs ||
+ 	    i == (int) &((struct proc *) 0)->p_reg.ds ||
+ 	    i == (int) &((struct proc *) 0)->p_reg.es ||
+ #if INTEL_32BITS
+ 	    i == (int) &((struct proc *) 0)->p_reg.gs ||
+ 	    i == (int) &((struct proc *) 0)->p_reg.fs ||
+ #endif
+ 	    i == (int) &((struct proc *) 0)->p_reg.ss)
+ 		return(EIO);
+ #endif
+ 	if (i == (int) &((struct proc *) 0)->p_reg.psw)
+ 		/* only selected bits are changeable */
+ 		SETBITS(rp, DATA);
+ 	else
+ 		*(reg_t *) ((char *) &rp->p_reg + i) = (reg_t) DATA;
+ 	DATA = 0;
+ 	break;
+ 		return EIO;
+ #endif
+ 		break;
+ 	case 7: /* resume execution */
+ 		rp->p_flags &= ~P_STOP;
+ 		if (rp->p_flags == 0) ready(rp);
+ 		DATA = 0;
+ 		break;
+ 	case 9: /* set trace bit */
+ #if (MACHINE == PC532)
+ 		rp->p_mod_psr |= TRACEBIT;
+ #else
+ 		rp->p_pcpsw.psw |= TRACEBIT;
+ #endif
+ 		rp->p_flags &= ~P_STOP;
+ 		if (rp->p_flags == 0) ready(rp);
+ 		DATA = 0;
+ 		break;
+ 	default: return EIO;
+   }
+   return OK;
+ }
+ #endif /* DO_PTRACE */
  
