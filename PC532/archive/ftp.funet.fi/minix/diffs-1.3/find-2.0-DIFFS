*** 88,100 ****
  DIRINSTALL = install -d
  
  # Directory in which to install `find' and `locate'.
! BINDIR=/usr/local/gnubin
  
  # Directory in which to install programs to create the `locate' database.
! LIBDIR=/usr/local/lib/find
  
  # Directory in which to install manual pages.
! MANDIR=/usr/local/man/man1
  
  # Data file for `locate'.
  FCODES=$(LIBDIR)/find.codes
--- 88,100 ----
  DIRINSTALL = install -d
  
  # Directory in which to install `find' and `locate'.
! BINDIR=/usr/gnu/bin
  
  # Directory in which to install programs to create the `locate' database.
! LIBDIR=/usr/gnu/lib/find
  
  # Directory in which to install manual pages.
! MANDIR=/usr/gnu/man/man1
  
  # Data file for `locate'.
  FCODES=$(LIBDIR)/find.codes
***************
*** 104,112 ****
  # Arguments to pass to subdirectory makes.
  MDEFINES = BINDIR=$(BINDIR) LIBDIR=$(LIBDIR) MANDIR=$(MANDIR) \
  FCODES=$(FCODES) INSTALL='$(INSTALL)' DOCINSTALL='$(DOCINSTALL)' \
! DIRINSTALL='$(DIRINSTALL)' AR='$(AR)' RANLIB='$(RANLIB)'
  # Add for versions of make that don't pass them in $(MAKE):
- # CFLAGS='$(CFLAGS)' LDFLAGS='$(LDFLAGS)' LIBS='$(LIBS)' CC='$(CC)'
  
  SUBDIRS = lib find xargs locate man
  
--- 104,112 ----
  # Arguments to pass to subdirectory makes.
  MDEFINES = BINDIR=$(BINDIR) LIBDIR=$(LIBDIR) MANDIR=$(MANDIR) \
  FCODES=$(FCODES) INSTALL='$(INSTALL)' DOCINSTALL='$(DOCINSTALL)' \
! DIRINSTALL='$(DIRINSTALL)' AR='$(AR)' RANLIB='$(RANLIB)' \
! CFLAGS='$(CFLAGS)' LDFLAGS='$(LDFLAGS)' LIBS='$(LIBS)' CC='$(CC)'
  # Add for versions of make that don't pass them in $(MAKE):
  
  SUBDIRS = lib find xargs locate man
  
