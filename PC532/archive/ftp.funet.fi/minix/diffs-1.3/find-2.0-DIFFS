***************
*** 30,36 ****
  # Directory to hold intermediate files.
  TMPDIR=/usr/tmp
  
! PATH=$LIBDIR:$BINDIR:/usr/ucb:/bin:/usr/bin export PATH
  bigrams=$TMPDIR/f.bigrams$$
  filelist=$TMPDIR/f.list$$
  errs=$TMPDIR/f.errs$$
--- 30,37 ----
  # Directory to hold intermediate files.
  TMPDIR=/usr/tmp
  
! PATH=$LIBDIR:$BINDIR:/usr/ucb:/bin:/usr/bin
! export PATH
  bigrams=$TMPDIR/f.bigrams$$
  filelist=$TMPDIR/f.list$$
  errs=$TMPDIR/f.errs$$
