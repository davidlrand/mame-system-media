  getwd (pathname)
       char *pathname;
  {
+ #ifdef GETCWD_NEEDS_BUF
+   char buf[MAXPATHLEN];
+ #endif
    char *npath, *spath;
    extern char *getcwd ();
  
+ #ifdef GETCWD_NEEDS_BUF
+   getcwd (buf, MAXPATHLEN);
+   spath = npath = buf;
+ #else
    spath = npath = getcwd ((char *) 0, MAXPATHLEN);
+ #endif
    /* On Altos 3068, getcwd can return @hostname/dir, so discard
       up to first slash.  Should be harmless on other systems.  */
    while (*npath && *npath != '/')
      npath++;
    strcpy (pathname, npath);
+ #ifndef GETCWD_NEEDS_NO_FREE
    free (spath);			/* getcwd uses malloc */
+ 				/* no it doesn't, often */
+ #endif
    return pathname;
  }
  
