--- 21,28 ----
  # Variables that exist for you to override.
  # See below for how to change them for certain systems.
  
! CFLAGS = -O $(XCFLAGS)
! CC = gcc
  BISON = bison
  BISONFLAGS = -v
  # This should be the version of ar to use with output from GCC.
