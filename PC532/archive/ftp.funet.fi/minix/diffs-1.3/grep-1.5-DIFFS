diff -cr grep-1.5.orig/getopt.c grep-1.5/getopt.c
*** grep-1.5.orig/getopt.c	Tue Feb 28 23:44:55 1989
--- grep-1.5/getopt.c	Sat Dec  1 04:41:29 1990
***************
*** 112,117 ****
--- 112,121 ----
  
  #ifdef sparc
  #include <alloca.h>
+ #else
+ #ifdef __GNUC__
+ #define alloca __builtin_alloca
+ #endif
  #endif
  #ifdef USG
  #define bcopy(s, d, l) memcpy((d), (s), (l))
