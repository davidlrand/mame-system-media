*** 240,245 ****
--- 240,269 ----
  		cpu_type=ns32k
  		configuration_file=xm-genix.h
  		;;
+ 	pc532 | pc532-gas)	# PC532 with Minix and GNU utils
+ 		machine=pc532-gas
+ 		cpu_type=ns32k
+ 		target_machine=tm-pc532.h
+ 		configuration_file=xm-pc532.h
+ 		;;
+ 	pc532-wbc)		# PC532 with Minix and WBC assembler
+ 		machine=pc532-wbc
+ 		cpu_type=ns32k
+ 		target_machine=tm-pc532wbc.h
+ 		configuration_file=xm-pc532.h
+ 		;;
+ 	icm | icm3216)		# ICM 3216 with GNU utils
+ 		machine=icm-gas
+ 		cpu_type=ns32k
+ 		target_machine=tm-icm-gas.h
+ 		configuration_file=xm-genix.h
+ 		;;
+ 	icm-native)		# ICM 3216 native assembler syntax
+ 		machine=icm-nat
+ 		cpu_type=ns32k
+ 		target_machine=tm-icm-nat.h
+ 		configuration_file=xm-genix.h
+ 		;;
  	88000)
  		cpu_type=m88k
  		target_machine=tm-${cpu_type}.h
