+ /* We'll use gas syntax if WBC syntax is not used */
+ 
+ #ifndef WBC
+ #define GAS_SYNTAX
+ #endif
+ 
+ #include "tm-ns32k.h"
+ 
+ /* Compile for the floating point unit by default */
+ 
+ #define TARGET_DEFAULT 1
+ 
+ /* Use memcpy etc. instead of bcopy etc. */
+ 
+ #define TARGET_MEM_FUNCTIONS
+ 
+ /* When we make a profiler, define this right, now it's from
+    tm-ns32k.h and just a guess */
+ 
+ #undef FUNCTION_PROFILER
+ #define FUNCTION_PROFILER(FILE, LABELNO)  \
+    fprintf (FILE, "\taddr LP%d,r0\n\tbsr mcount\n", (LABELNO))
+ 
+ /* Minix has crtso.o instead of crt0.o */
+ #undef STARTFILE_SPEC
+ #define STARTFILE_SPEC  \
+   "%{pg:gcrtso.o%s}%{!pg:%{p:mcrtso.o%s}%{!p:crtso.o%s}}"
