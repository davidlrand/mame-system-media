diff -cr perl-3.0.41.or/makedepend.SH perl-3.0.41/makedepend.SH
*** perl-3.0.41.or/makedepend.SH	Wed Dec  5 18:13:07 1990
--- perl-3.0.41/makedepend.SH	Thu Dec  6 19:23:19 1990
***************
*** 101,108 ****
  	$echo *.SH | $tr ' ' '\012' | $egrep -v '\*' >.shlist)
  if $test -s .deptmp; then
      for file in `cat .shlist`; do
! 	$echo `$expr X$file : 'X\(.*\).SH`: $file config.sh \; \
! 	    /bin/sh $file >> .deptmp
      done
      $echo "Updating Makefile..."
      $echo "# If this runs make out of memory, delete /usr/include lines." \
--- 101,110 ----
  	$echo *.SH | $tr ' ' '\012' | $egrep -v '\*' >.shlist)
  if $test -s .deptmp; then
      for file in `cat .shlist`; do
! 	$expr X$file : 'X\(.*\).SH' > .xx
! 	$echo `$cat .xx`: $file config.sh >> .deptmp
! 	$echo '	' /bin/sh $file >> .deptmp
! 	$rm -f .xx
      done
      $echo "Updating Makefile..."
      $echo "# If this runs make out of memory, delete /usr/include lines." \
