diff -cr diff-1.15.orig/Makefile diff-1.15/Makefile
*** diff-1.15.orig/Makefile	Mon Jan  7 00:02:56 1991
--- diff-1.15/Makefile	Mon Feb  4 19:09:44 1991
***************
*** 21,27 ****
  # but gcc makes it faster.
  # Also, gcc supports -O and -g together.
  CC=gcc -O
! CFLAGS = -g
  INSTALL = install
  
  # On system V, enable these three lines:
--- 21,27 ----
  # but gcc makes it faster.
  # Also, gcc supports -O and -g together.
  CC=gcc -O
! CFLAGS = -DUSG -DMINIX #-g
  INSTALL = install
  
  # On system V, enable these three lines:
***************
*** 47,53 ****
  ALLOCA = 
  # ALLOCA = $(archpfx)/alloca.o
  
! bindir=/usr/local/bin
  prefix=
  
  # All source files
--- 47,53 ----
  ALLOCA = 
  # ALLOCA = $(archpfx)/alloca.o
  
! bindir=/usr/gnu/bin
  prefix=
  
  # All source files
diff -cr diff-1.15.orig/diff.h diff-1.15/diff.h
*** diff-1.15.orig/diff.h	Sun Jan  6 23:04:45 1991
--- diff-1.15/diff.h	Mon Feb  4 18:57:13 1991
***************
*** 52,58 ****
--- 52,60 ----
  #define bzero(s,n)	memset((s),0,(n))
  
  #ifndef XENIX
+ #ifndef MINIX
  #define dup2(f,t)	(close(t),fcntl((f),F_DUPFD,(t)))
+ #endif
  #endif
  
  #define vfork	fork
