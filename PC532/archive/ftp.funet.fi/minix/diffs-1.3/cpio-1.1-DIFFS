diff -cr cpio-1.1.orig/Makefile cpio-1.1/Makefile
*** cpio-1.1.orig/Makefile	Sat Jul  7 19:48:26 1990
--- cpio-1.1/Makefile	Thu Dec  6 21:58:21 1990
***************
*** 29,38 ****
  # -DVPRINTF_MISSING	If you lack vprintf function (but have _doprnt).
  # -DBCOPY_MISSING	If you lack bcopy function.
  # -DMKDIR_MISSING	If you lack mkdir system call.
! DEFS = -I. -DDIRENT
! CFLAGS = -g $(DEFS)
  
! LDFLAGS = -g
  
  LIBS = #-ldir -lx
  
--- 29,38 ----
  # -DVPRINTF_MISSING	If you lack vprintf function (but have _doprnt).
  # -DBCOPY_MISSING	If you lack bcopy function.
  # -DMKDIR_MISSING	If you lack mkdir system call.
! DEFS = -I. -DDIRENT -DMTIO_MISSING -DBCOPY_MISSING -DMKDIR_MISSING -DMINIX
! CFLAGS = -O $(DEFS)
  
! LDFLAGS = 
  
  LIBS = #-ldir -lx
  
