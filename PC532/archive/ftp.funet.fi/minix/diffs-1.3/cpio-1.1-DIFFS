diff -cr cpio-1.1.orig/glob.c cpio-1.1/glob.c
*** cpio-1.1.orig/glob.c	Thu Jun 14 17:21:31 1990
--- cpio-1.1/glob.c	Thu Dec  6 22:00:01 1990
***************
*** 53,60 ****
--- 53,69 ----
  #define index strchr
  #define rindex strrchr
  #else /* not USG */
+ #ifdef MINIX
+ #include <string.h>
+ #define bcopy(s, d, n) memcpy ((d), (s), (n))
+ #define index strchr
+ #define rindex strrchr
+ #else
  #include <strings.h>
+ #endif
+ #ifndef MINIX
  extern void bcopy ();
+ #endif
  #endif /* not USG */
  
  extern char *malloc ();
