diff -cr fileut-1.4.or/mvdir.c fileutils-1.4/mvdir.c
*** fileut-1.4.or/mvdir.c	Tue Sep  4 15:00:09 1990
--- fileutils-1.4/mvdir.c	Sat Dec  1 02:23:57 1990
***************
*** 33,38 ****
--- 33,42 ----
  #include <signal.h>
  #include "system.h"
  
+ #ifdef MINIX_13
+ #define PATH_MAX 1024
+ #endif
+ 
