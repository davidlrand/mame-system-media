***************
*** 139,145 ****
--- 143,151 ----
      if (i != SIGKILL)
        signal (i, SIG_IGN);
    setuid (0);			/* Make real uid 0 so it is harder to kill. */
+ #ifndef MINIX_13
    nice (HIPRI - nice (0));	/* Raise priority. */
+ #endif
  
    if (link (from, to))
      error (1, errno, "cannot link `%s' to `%s'", from, to);
