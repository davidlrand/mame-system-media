diff -cr fileut-1.4.or/Makefile fileutils-1.4/Makefile
*** fileut-1.4.or/Makefile	Sun Sep  9 20:50:58 1990
--- fileutils-1.4/Makefile	Sat Dec  1 02:22:32 1990
***************
*** 52,59 ****
  #LIBS = $(LIBOBJS)
  
  # SunOS 4.[01]
! DEFS = -DDIRENT -DMKTIME_MISSING -DMKFIFO_MISSING
! LIBS = $(LIBOBJS)
  
  # Ultrix 4.0
  #DEFS = -DDIRENT
--- 52,59 ----
  #LIBS = $(LIBOBJS)
  
  # SunOS 4.[01]
! #DEFS = -DDIRENT -DMKTIME_MISSING -DMKFIFO_MISSING
! #LIBS = $(LIBOBJS)
  
  # Ultrix 4.0
  #DEFS = -DDIRENT
***************
*** 92,111 ****
  # Minix with gcc
  #DEFS = -DUSG -DSTDC_HEADERS -D_POSIX_SOURCE -DFCHMOD_MISSING -DDIRENT \
  #	-DFTRUNCATE_MISSING -DSTBLOCKS_MISSING -DDEV_BSIZE=1024 -D_MINIX
! #LIBS = $(LIBOBJS)
  
! CFLAGS = -I. -g $(DEFS)
! LDFLAGS = -g
  
  # Object files that are linked with every program except dd.
  LIBOBJS = getopt.o getopt1.o
  
  # Where to install the executables.
! BINDIR = /usr/local/gnubin
  # Where to put mvdir on systems lacking the rename system call.
! LIBDIR = /usr/local/lib
  # Where to put the Unix-style manual pages.
! MANDIR = /usr/local/man/man1
  
  # Executable files in this directory.
  PROGS = cat chmod cmp cp cut dd du ginstall head ln dir vdir ls \
--- 92,116 ----
  # Minix with gcc
  #DEFS = -DUSG -DSTDC_HEADERS -D_POSIX_SOURCE -DFCHMOD_MISSING -DDIRENT \
  #	-DFTRUNCATE_MISSING -DSTBLOCKS_MISSING -DDEV_BSIZE=1024 -D_MINIX
! DEFS = -DUSG -DFCHMOD_MISSING -DDIRENT -DMKDIR_MISSING -D_POSIX_SOURCE \
! 	-DFTRUNCATE_MISSING -DSTBLOCKS_MISSING -DDEV_BSIZE=1024 -D_MINIX \
! 	-DMKTIME_MISSING -DMVDIR=\"$(LIBDIR)/mvdir\" -DMKFIFO_MISSING \
! 	-DMINIX_13 -DRENAME_MISSING
! LIBS = $(LIBOBJS)
! LIBPROGS = mvdir
  
! CFLAGS = -I. $(DEFS)
! LDFLAGS =
  
  # Object files that are linked with every program except dd.
  LIBOBJS = getopt.o getopt1.o
  
  # Where to install the executables.
! BINDIR = /usr/gnu/bin
  # Where to put mvdir on systems lacking the rename system call.
! LIBDIR = /usr/gnu/lib
  # Where to put the Unix-style manual pages.
! MANDIR = /usr/gnu/man/man1
  
  # Executable files in this directory.
  PROGS = cat chmod cmp cp cut dd du ginstall head ln dir vdir ls \
diff -cr fileut-1.4.or/cp.c fileutils-1.4/cp.c
*** fileut-1.4.or/cp.c	Mon Sep  3 01:14:52 1990
--- fileutils-1.4/cp.c	Sat Dec  1 01:45:27 1990
***************
*** 738,744 ****
--- 738,748 ----
    /* Create the new regular file with small permissions initially,
       to not create a security hole.  */
  
+ #ifdef O_TRUNC
    target_desc = open (dst_path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+ #else
+   target_desc = open (dst_path, O_WRONLY | O_CREAT, 0600);
+ #endif
    if (target_desc < 0)
      {
        error (0, errno, "cannot create regular file `%s'", dst_path);
