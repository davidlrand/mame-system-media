+ + 		  sed 's/^.define \([a-z]*\).*/\1/'` ; do \
+ + 	echo $${f} ; \
+ + 	sed -e "s/XYZ/$${f}/g" < Hidden > _u_$${f}.s ; \
+ + 	as -o _u_$${f}.o _u_$${f}.s ; \
+ + 	done ; \
+ + 	fi
+ + 	echo -n >Hide
+ + 
+ + # Put together a library
+ + 
+ + FPobjects:	$(FPOBJ)
+ + 
+ + FPorder:	$(FPOBJ) Hide
+ + 	echo -n >FPorder
