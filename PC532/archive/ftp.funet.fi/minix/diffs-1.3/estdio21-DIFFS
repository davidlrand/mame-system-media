+ + 	  n=`basename $$f .c` ; \
+ + 	  $(FPCC) $(CFLAGS) -I.. $$n.c ; \
+ + 	  $(FPLD) $$n $$n.o ../stdiofp.a ../stdio.a $(MathLibraries) ; \
+ + 	done
+ + 
+ + update:
+ + 	-if test -z "$(LIBC)" ; then \
+ + 	  echo Usage: make update LIBC=library ; \
+ + 	else \
+ + 	  ar t $(LIBC) | sed -e 's/ //g' | sort > libc.files ; \
+ + 	  ar rv $(LIBC) `ls *.o | comm -12 - libc.files` ; \
+ + 	  rm -f libc.files ; \
+ + 	  $(RANLIB) $(LIBC); \
+ + 	fi
+ + 
+ + # Library dependencies
+ + 
