+ + test:
+ + 	-cd $(Testdir) ; \
+ + 	for f in *.c ; do \
+ + 	  n=`basename $$f .c` ; \
+ + 	  $(CC) $(CFLAGS) -I.. $$n.c ; \
+ + 	  $(LD) $$n $$n.o ../stdio.a ; \
+ + 	done
+ + 
+ + fptest:
