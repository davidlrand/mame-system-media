{
	char far *p;
	
	jcb_1.status_byte =FAULT;
	jcb_1.target_id = TARGET_ID;
	jcb_1.lun_no = 0;
	jcb_1.arb = YES;
	jcb_1.initiator_id = YES;
	jcb_1.attention = YES;
	jcb_1.disconnect = YES;
	jcb_1.direction = IN;		/* Input direction (although no data transfer)	*/
	jcb_1.data_len = 0;		/* No data transfer		*/
	jcb_1.data_addr = &buffer[0];	/* Input bytes would be to buffer	*/
	jcb_1.cdb_len = 6;

	jcb_1.cdb_0 = RELEASE_UNIT;
	jcb_1.cdb_1 = 0;
	jcb_1.cdb_2 = 0;
	jcb_1.cdb_3 = 0;
	jcb_1.cdb_4 = 0;
	jcb_1.cdb_5 = 0;

	p = &jcb_1.status_byte;
	regs.x.bx = FP_OFF(p);
	sregs.es = FP_SEG(p);

	regs.h.ah = SCSI_PRO;
