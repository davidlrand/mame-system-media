.module	blt32.c
.program
.endseg
.program
; Version 1.2  Thu Apr  2 19:23:21 1987
;
;	Inputs:
;		r0 = source address
;		r1 = destination address
;		r2 = shift value
;		r3 = first mask
;		r4 = second mask
;		r5 = temporary 1
;		r6 = temporary 2
;		r7 = destination warp
;
;	Ouputs:
;		Data in memory changed.
;	

blt32:
;line 1
	movw	0(r0),r5	;pick up first word
	lshd	r2,r5		;shift it to align
	andd	r3,r5		;destination mask it
	movd	0(r1),r6	;get destination
	comd	r3,r3		;complement mask
	andd	r3,r6		;mask destination
	ord	r5,r6		;merge with source
	movd	r6,0(r1)	;and place in destination

	movw	2(r0),r5	;get next word
	lshd	r2,r5		;shift to align
	andd	r4,r5		;destination mask it
	movd	2(r1),r6	;get destination
	comd	r4,r4		;complement mask
	andd	r4,r6		;mask destination
	ord	r5,r6		;merge with source
	movd	r6,2(r1)	;and place in destination
	addqd	2,r0
	addd	r7,r1
