.module	blt32.c
.program
.endseg
.program
; Version 1.1  Sun Mar 29 14:12:25 1987
;
;	Inputs:
;		r0 = source address
;		r1 = destination address
;		r2 = shift value
;		r3 = used as temporary
;		r4 = used as temporary
;		r5 = destination warp
;
;	Ouputs:
;		Data in memory changed.
;	

blt32:
;line 1
	movzwd	0(r0),r3	;pick up first
	movzwd	2(r0),r4	;two source words
	lshd	r2,r3		;shift source 1
	ord	r3,0(r1)	;or into destination
	lshd	r2,r4		;shift second (overlaps previous instr)
	ord	r4,2(r1)	;or into destination
	addqd	4,r0		;add source warp
	addd	r5,r1		;add destination warp
;line 2
	movzwd	0(r0),r3	;pick up first
