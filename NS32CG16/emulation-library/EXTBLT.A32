	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 13
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 14
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 15
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 16
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 17
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 18
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 19
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 20
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 21
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
