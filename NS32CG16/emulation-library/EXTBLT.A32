.module	extblt.c
.program
.endseg
.program
; Version 1.2  Mon Mar 30 11:46:15 1987
;
;This code runs the DP8510/11, using the 32016. An external latch
;is assumed to control the LME and RME pins of the 8510, as well
;as the logic for enabling the BPU. A 'disable logic' bit is included
;in this latch as well, to help the hardware determine when a BPU cycle
;is actually occuring.
;
;Timing data is 3285 clocks per character on 32016 with 1 wait state.
;Time for a page using BPU is 1.150 seconds.
;(3,500 characters/page @ 10 Mhz with 32016 and 1 wait state.)
;
;	Inputs:
;		r0 = source address
;		r1 = destination address
;		r2 = BPU register
;		r3 = source warp
;		r4 = destination warp
;
;	Ouputs:
;		Data in memory changed.
;		r0, r1, r3 altered.
;	
.static
bpu:	word	0		;BPU control register
	.align	4
latch:	word	0		;latch address for bpu control
.endseg

lme:	equ	1		;left mask enable value
rme:	equ	2		;right mask enable value
nme:	equ	0		;no mask value
bpuoff:	equ	4		;value to turn logic off


blt32:
	movw	r2,bpu		;setup bpu
;line 1
	movb	lme,latch	;we want left mask
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 2
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 3
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 4
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 5
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 6
