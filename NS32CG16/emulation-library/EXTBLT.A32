	orw	4(r0),2(r1)	;do last word of destination
;	addd	r3,r0
;	addd	r4,r1

	movb	bpuoff,latch	;turn bpu logic off

	ret	0

	.static
ctime:	double	0
loopv:	double	0
runlen:	double	0

mess:	byte	10,'Total execution time for 3500 loops is %d msec',10,0
buf:	blkb	128

	.align	4
bits:	blkb	1024

	.endseg

_main:-	
	movd	3500,loopv
	movqd	0,tos
	cxp	_timer
	cmpqd	0,tos
	movd	r0,ctime
	movw	h'E800,r3		;BPU control, s or d, 8 shift
	movqd	4,r3			;source warp
	movqd	4,r4			;destination warp

	.align	4
loop:
	addrd	mess,r0			;source address
	addrd	bits,r1			;destination address
	bsr	blt32			;call the function
	acbd	-1,loopv,loop		;and loop for more
	
	movqd	0,tos
	cxp	_timer			;get current timer value
	cmpqd	0,tos
	subd	ctime,r0		;subtract start time
	movd	r0,tos			;save on stact
	addrd	mess,tos		;and place address of message
	cxp	_printf
	cmpd	tos,tos			;unstack
	rxp	0			;and return

	.importp _timer,_printf
.endseg
