	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 24
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 25
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 26
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 27
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 28
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 29
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 30
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
	addd	r3,r0
	addd	r4,r1
;line 31
	movw	0(r0),r2	;get first word into bpu
	orw	2(r0),0(r1)	;do first word of destination
	movb	rme,latch	;setup right mask
	orw	4(r0),2(r1)	;do last word of destination
